{
  "manifest_version": 2,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/cengizkemec/auto-refresh-plus-firefox",
  "developer": {
    "name": "Cengiz Kemeç",
    "url": "https://github.com/cengizkemec"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "menus"
  ],
  "browser_action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "commands": {
    "toggle-auto-refresh": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "__MSG_commandToggleDescription__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-refresh-plus@cengizkemec.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
